# API Key de Google Gemini (Requerida para estructurar la extracción de PDFs)
GEMINI_API_KEY=tu_api_key_aqui

# Modelo de Gemini a utilizar (Por defecto: gemini-2.0-flash)
GEMINI_MODEL=gemini-2.0-flash
